# Firebase Configuration
# Copy this file to .env.local and populate the values with your actual Firebase project settings.
# Do NOT commit your actual .env.local file to source control.

VITE_FIREBASE_API_KEY="your_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_here"
VITE_FIREBASE_APP_ID="your_app_id_here"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id_here"

# Comma-separated list of authorized administrator email addresses (for role-based security)
VITE_AUTHORIZED_ADMINS="admin@scfstudios.com"
